# Copie para .env e preencha. O .env real nunca é versionado.
#
# REGRA: nunca prefixe um segredo com VITE_.
# Tudo que começa com VITE_ é embutido em texto claro no JavaScript enviado ao
# navegador e fica público para qualquer visitante.

# Chave do Gemini — lida APENAS pelo servidor, em api/chat.ts.
# Em produção vive na Vercel (Settings > Environment Variables), não aqui.
GEMINI_API_KEY=""

# Chave pública do Firebase. Não é segredo — o Firebase a expõe por design.
# A proteção real vem das Security Rules (ver database.rules.json).
VITE_FIREBASE_API_KEY=""
